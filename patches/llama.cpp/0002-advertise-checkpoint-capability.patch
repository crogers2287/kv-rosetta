 static json get_res_props(const server_context_meta & meta, const common_params & params, bool is_sleeping) {
+    // Derived from the launch configuration, not from what the checkpoint format can hold.
+    json active_checkpoint_state_classes = json::array({ "target" });
+    if (params.speculative.has_dft()) {
+        active_checkpoint_state_classes.push_back("draft");
+    }
+    for (const auto & type : params.speculative.types) {
+        if (type != COMMON_SPECULATIVE_TYPE_NONE) {
+            active_checkpoint_state_classes.push_back("speculative");
+            break;
+        }
+    }
     // note: do NOT use ctx_server here, otherwise it's not possible to use this during sleep
 
     task_params tparams;
@@ -4721,6 +4762,40 @@
         { "eos_token",                   meta.eos_token_str },
         { "build_info",                  meta.build_info },
         { "is_sleeping",                 is_sleeping },
+        // KV Rosetta: machine-readable checkpoint-persistence protocol. A client must not
+        // enable hybrid restoration from an architecture name, a commit, a filename, a
+        // strings(1) match or an artifact size - all of those describe the build, not the
+        // behaviour. These fields describe the behaviour.
+        { "slot_checkpoint_persistence",         true },
+        { "slot_checkpoint_format",              "sckp/1" },
+        { "sequence_state_version",              LLAMA_STATE_SEQ_VERSION },
+        // SERIALIZATION is what the format writes; SUPPORT is what has been shown to work.
+        // A compile-time struct member is not a runtime capability, so these are reported
+        // separately and a consumer must not conflate them.
+        { "sckp_serializes_target_state",        true },
+        { "sckp_serializes_draft_state",         true },
+        { "sckp_serializes_speculative_state",   true },
+        // Behavioural support. Target state has a passing restart test on the non-MTP
+        // path. Draft and speculative restoration have never been exercised here, so they
+        // are reported false until a retained test proves them - advertising them as true
+        // would let a consumer enable a configuration nothing has verified.
+        { "supports_target_checkpoint_state",    true },
+        { "supports_draft_checkpoint_state",     false },
+        { "supports_speculative_checkpoint_state", false },
+        // Which checkpoint state classes THIS launch actually requires. A consumer cannot
+        // tell from the flags above whether the unproven classes are merely unsupported or
+        // are actively in use: a checkpoint stores target, draft and speculative state
+        // together, so a launch with a draft model produces checkpoints whose restoration
+        // has never been verified. Without this, a target-only configuration cannot be
+        // distinguished from a speculative one and both have to be refused.
+        { "active_checkpoint_state_classes",     active_checkpoint_state_classes },
+        // The live target context's K/V cache types. A cache written under one pair is not
+        // interchangeable with one written under another, so a consumer must be able to
+        // bind these into cache identity rather than infer them from the model file.
+        { "target_cache_type_k",                 meta.cache_type_k },
+        { "target_cache_type_v",                 meta.cache_type_v },
+        { "draft_cache_type_k",                  meta.draft_cache_type_k },
+        { "draft_cache_type_v",                  meta.draft_cache_type_v },
         { "cors_proxy_enabled",          params.ui_mcp_proxy },
     };
